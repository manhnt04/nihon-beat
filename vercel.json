{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/inventory", "destination": "/" },
    { "source": "/shop", "destination": "/" },
    { "source": "/profile", "destination": "/" },
    { "source": "/profile/codex", "destination": "/" },
    { "source": "/pvp", "destination": "/" },
    { "source": "/leaderboard", "destination": "/" },
    { "source": "/dictionary", "destination": "/" },
    { "source": "/lessons", "destination": "/" },
    { "source": "/play", "destination": "/" },
    { "source": "/result", "destination": "/" }
  ]
}
